+func TestVerificationChallengeHTTPFailureRecorded(t *testing.T) {
+	r := newBaselineTestRun(t)
+	r.options.RequestTimeout = time.Second
+	row := r.evidence.Requests[0]
+	handler := r.observe(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+		w.Header().Set("X-Request-Id", "challenge-failure")
+		w.WriteHeader(http.StatusServiceUnavailable)
+		_, _ = w.Write([]byte(`{"code":"STATE_UNAVAILABLE","requestId":"challenge-failure"}`))
+	}), func() experiment.Row { return row })
+	r.action(t.Context(), row, nil, func(ctx context.Context) error {
+		handler.ServeHTTP(httptest.NewRecorder(), httptest.NewRequestWithContext(ctx, http.MethodPost, "/v1/auth/challenges", nil))
+		// The wallet returns an HTTP error status as its result with no Go error.
+		return nil
+	})
+	if row["http_status"] != http.StatusServiceUnavailable || row["failure_stage"] != "challenge" || row["request_id"] != "challenge-failure" {
+		t.Fatalf("challenge returned 503 STATE_UNAVAILABLE, evidence recorded status=%v stage=%v request_id=%v", row["http_status"], row["failure_stage"], row["request_id"])
+	}
+}
