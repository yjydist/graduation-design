+package main
+
+import (
+	"testing"
+
+	api "graduation-design/internal/fabricapi"
+)
+
+func TestVerificationRawRecoveryWithoutProofChangesBinding(t *testing.T) {
+	h := newRegistryHarness(t)
+	id, err := get[api.Identity](h.stub, api.Key("identity", "did:web:b.local:b1"))
+	if err != nil { t.Fatal(err) }
+	_, newMgmt := makeSerializedCaller(t, "BMsp", "unproven-new-manager")
+	_, pub := makeAppKey(t, id.ID)
+	h.stub.creator = h.bReg
+	// No recovery challenge, application proof, or management proof exists.
+	_, err = invoke(h.stub, "RecoverIdentity", mustJSON(t, api.RecoverIdentityInput{
+		Bound: api.Bound{DeploymentID: h.depID}, ID: id.ID,
+		ExpectedRevision: id.Revision, ExpectedKeyVersion: id.KeyVersion,
+		AccountCommitment: id.AccountCommitment, OldManagement: id.Management, NewManagement: newMgmt,
+		DocumentDigest: api.Digest([]byte("new-document")), KeyID: id.ID + "#key-2", PublicKey: pub,
+	}))
+	if err == nil {
+		after, readErr := get[api.Identity](h.stub, api.Key("identity", id.ID))
+		if readErr != nil { t.Fatal(readErr) }
+		t.Fatalf("raw registrar submission accepted without either proof: managementChanged=%v keyVersion=%d", after.Management != id.Management, after.KeyVersion)
+	}
+}
