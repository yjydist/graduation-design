+func TestVerifyManagementHTTPActuallySubmits(t *testing.T) {
+ pool:=testPgPool(t); ctx:=t.Context();depID:=strings.Repeat("e",64)
+ defer func(){_,_=pool.Exec(ctx,`DELETE FROM operations WHERE deployment_id=$1`,depID)}()
+ calls:=make(chan struct{},1)
+ svc:=NewManagementOperationService(pool,depID,api.Management{}, &verificationBackend{calls:calls})
+ req:=httptest.NewRequest(http.MethodPost,"/v1/management/RotateIdentity",strings.NewReader(`{"id":"did:web:a.local:u","expectedRevision":2}`))
+ req.Header.Set("Idempotency-Key","verify-http-submit")
+ req.Header.Set("X-Caller-MSPID","AMsp"); req.Header.Set("X-Caller-Fingerprint",strings.Repeat("a",64))
+ rec:=httptest.NewRecorder();svc.Handler().ServeHTTP(rec,req)
+ if rec.Code!=http.StatusAccepted {t.Fatalf("expected accepted request, got %d %s",rec.Code,rec.Body.String())}
+ select {case <-calls: case <-time.After(100*time.Millisecond):t.Error("HTTP returned 202 but never invoked configured SubmitAsync backend")}
+}
+type verificationBackend struct {calls chan struct{}}
+func (b *verificationBackend) CurrentRevision(context.Context,string,json.RawMessage)(uint64,bool,error){return 2,true,nil}
+func (b *verificationBackend) SubmitAsync(ctx context.Context,key,id string,caller api.Management,method string,input json.RawMessage,onUpdate func(string,string,string,int64,string,*string,*string,bool)error){b.calls<-struct{}{}}
