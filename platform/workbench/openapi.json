          "status": {"type":"string"},
          "decisionId": {"type":"string"}
        }
      },
      "DelegationEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["grantId","rootId","mode","issuerDid","granteeDid","status","revision","remainingDepth","nbf","exp"],
        "properties": {
          "grantId": {"type":"string"},
          "parentId": {"type":"string"},
          "rootId": {"type":"string"},
          "mode": {"$ref":"#/components/schemas/AuthorizationMode"},
          "issuerDid": {"type":"string"},
          "granteeDid": {"type":"string"},
          "status": {"type":"string"},
          "revision": {"type":"integer","minimum":1},
          "maxAmountMinor": {"type":"integer","minimum":1},
          "remainingDepth": {"type":"integer","minimum":0},
          "nbf": {"type":"integer","format":"int64"},
          "exp": {"type":"integer","format":"int64"},
          "decisionId": {"type":"string"}
        }
      },
      "PurchaseEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId","productId","quantity","quotes","orders"],
        "properties": {
          "taskId": {"type":"string"},
          "productId": {"type":"string"},
          "quantity": {"type":"integer","minimum":1},
          "quotes": {"type":"array","items":{"$ref":"#/components/schemas/Quote"}},
          "orders": {"type":"array","items":{"$ref":"#/components/schemas/Order"}}
        }
      },
      "Quote": {
        "type": "object",
        "additionalProperties": false,
        "required": ["quoteId","taskId","actor","supplierId","productId","quantity","currency","unitPriceMinor","totalAmountMinor","issuedAt","validUntil"],
        "properties": {
          "quoteId": {"type":"string"},
          "taskId": {"type":"string"},
          "actor": {"type":"string"},
          "supplierId": {"type":"string"},
          "productId": {"type":"string"},
          "quantity": {"type":"integer","minimum":1},
          "currency": {"type":"string"},
          "unitPriceMinor": {"type":"integer","minimum":1},
          "totalAmountMinor": {"type":"integer","minimum":1},
          "issuedAt": {"type":"integer","format":"int64"},
          "validUntil": {"type":"integer","format":"int64"}
        }
      },
      "Order": {
        "type": "object",
        "additionalProperties": false,
        "required": ["orderId","quoteId","taskId","actor","supplierId","productId","quantity","currency","totalAmountMinor","idempotencyKey","status","createdAt"],
        "properties": {
          "orderId": {"type":"string"},
          "quoteId": {"type":"string"},
          "taskId": {"type":"string"},
          "actor": {"type":"string"},
          "supplierId": {"type":"string"},
          "productId": {"type":"string"},
          "quantity": {"type":"integer","minimum":1},
          "currency": {"type":"string"},
          "totalAmountMinor": {"type":"integer","minimum":1},
          "idempotencyKey": {"type":"string"},
          "status": {"type":"string"},
          "createdAt": {"type":"integer","format":"int64"}
        }
      },
      "DecisionSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action","outcome","code","blockNumber","blockHash","policyDigest","contextVersion","probeDeadline","decisionAt"],
        "properties": {
          "decisionId": {"type":"string"},
          "requestId": {"type":"string"},
          "probeTxId": {"type":"string"},
          "action": {"type":"string"},
          "outcome": {"type":"string"},
          "code": {"type":"string"},
          "quoteId": {"type":"string"},
          "orderId": {"type":"string"},
          "failedObjectId": {"type":"string"},
          "blockNumber": {"type":"integer","minimum":0},
          "blockHash": {"type":"string"},
          "policyDigest": {"type":"string"},
          "contextVersion": {"type":"integer","minimum":0},
          "probeDeadline": {"type":"integer","format":"int64"},
          "decisionAt": {"type":"integer","format":"int64"}
        }
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "description": "已授权主体或 C 审计者可访问的完整决策记录.",
        "required": [
          "stateSource","revision","stateReadAt","stateRechecks","deploymentId","decisionId","requestId",
          "challengeId","actor","taskId","action","idempotencyKey","outcome","code","blockNumber","blockHash",
          "revocationEpoch","probeTxId","probeBlock","probeSentAt","probeDeadline","probeSentMonoNs",
          "probeDeadlineMonoNs","decisionAt","rootDid","rootKeyVersion","domainRevision","policyDigest",
          "contextVersion","contextRiskLevel","contextObservedAt","contextAccessDeadline","effectiveDeadline","grantPath"
        ],
        "properties": {
          "stateSource": {"type":"string"},
          "revision": {"type":["integer","null"]},
          "stateReadAt": {"type":["string","null"],"format":"date-time"},
          "stateRechecks": {"type":"integer"},
          "deploymentId": {"type":"string"},
          "decisionId": {"type":"string"},
          "requestId": {"type":"string"},
          "challengeId": {"type":"string"},
          "actor": {"type":"string"},
          "taskId": {"type":"string"},
          "action": {"type":"string"},
          "idempotencyKey": {"type":"string"},
          "outcome": {"type":"string"},
          "code": {"type":"string"},
          "reason": {"type":"string"},
          "quoteId": {"type":"string"},
          "orderId": {"type":"string"},
          "blockNumber": {"type":["integer","null"]},
          "blockHash": {"type":["string","null"]},
          "revocationEpoch": {"type":["integer","null"]},
          "probeTxId": {"type":["string","null"]},
          "probeBlock": {"type":["integer","null"]},
          "probeSentAt": {"type":["integer","null"]},
          "probeDeadline": {"type":["integer","null"]},
          "probeSentAtNs": {"type":["integer","null"]},
          "probeDeadlineNs": {"type":["integer","null"]},
          "probeSentMonoNs": {"type":["integer","null"]},
          "probeDeadlineMonoNs": {"type":["integer","null"]},
          "probeCheckedMonoNs": {"type":["integer","null"]},
          "decisionAt": {"type":"integer"},
          "decisionAtNs": {"type":"integer"},
          "rootDid": {"type":"string"},
          "rootKeyVersion": {"type":"integer"},
          "domainId": {"type":"string"},
          "certificationId": {"type":"string"},
          "certificationDigest": {"type":"string"},
          "domainRevision": {"type":"integer"},
          "identityIssuer": {"type":"string"},
          "policyDigest": {"type":"string"},
          "contextVersion": {"type":"integer"},
          "contextRiskLevel": {"type":"string"},
          "contextObservedAt": {"type":"integer"},
          "contextAccessDeadline": {"type":"integer"},
          "effectiveDeadline": {"type":"integer"},
          "grantPath": {"type":["array","null"],"items":{"type":"string"}},
          "failedObjectId": {"type":"string"}
        }
      }
    }
  }
