          "identity": {"type":"array","items":{"$ref":"#/components/schemas/IdentityEvidence"}},
          "disclosures": {"type":"array","items":{"$ref":"#/components/schemas/DisclosureEvidence"}},
          "delegations": {"type":"array","items":{"$ref":"#/components/schemas/DelegationEvidence"}},
          "purchase": {"$ref":"#/components/schemas/PurchaseEvidence"},
          "decisions": {"type":"array","items":{"$ref":"#/components/schemas/DecisionSummary"}}
        }
      },
      "IdentityEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["did","kind","status","keyVersion","decisionId"],
        "properties": {
          "did": {"type":"string"},
          "domainId": {"type":"string","enum":["A","B","C"]},
          "issuerDid": {"type":"string"},
          "kind": {"type":"string"},
          "status": {"type":"string"},
          "keyVersion": {"type":"integer","minimum":1},
          "certificationId": {"type":"string"},
          "certificationDigest": {"type":"string"},
          "decisionId": {"type":"string"}
        }
      },
      "DisclosureEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subjectDid","issuerDid","credentialId","subjectKeyVersion","issuerKeyVersion","disclosed","status","decisionId"],
        "properties": {
          "subjectDid": {"type":"string"},
          "issuerDid": {"type":"string"},
          "credentialId": {"type":"string"},
          "subjectKeyVersion": {"type":"integer","minimum":1},
          "issuerKeyVersion": {"type":"integer","minimum":1},
